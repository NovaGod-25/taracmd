# build.py writes LF. If Git checked these out as CRLF on Windows, the CI
# "was a generated target hand-edited?" check would fail on line endings alone.
* text=auto eol=lf

*.png binary
*.jar binary
*.apk binary
*.keystore binary
# The signing key. text=auto usually detects binary, but "usually" is not good
# enough for the one file whose corruption would make every APK unsignable.
*.p12 binary
*.jks binary
