<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page draws its own top bar and its own light/dark palette off
         prefers-color-scheme, so the shell contributes nothing but a
         background that matches on first paint. DayNight so the window
         behind the WebView is not a white flash in dark mode. -->
    <style name="Theme.TaraCmd" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/card</item>
    </style>
</resources>
